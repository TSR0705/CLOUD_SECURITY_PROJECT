{
  "name": "@sug/shared",
  "version": "0.1.0",
  "description": "Core shared types and contracts across the gateway",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
