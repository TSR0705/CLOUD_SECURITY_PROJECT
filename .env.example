# ==============================================================================
# Secure Upload Gateway — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env for local development ONLY.
# NEVER commit real credentials, tokens, or private keys to source control.
#
# IN PRODUCTION & DOCKER:
# - All secrets MUST be mounted via Docker File Secrets (/run/secrets/*)
#   or resolved from secure parameter stores (e.g., AWS SSM Parameter Store).
# - Environment variables serve as local development fallbacks only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Non-secret configuration
# ------------------------------------------------------------------------------

# Application runtime environment: development | production | test
NODE_ENV=development

# Logging severity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Service network binding
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=sug-api

# Relational Database connection parameters (PostgreSQL 18)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=sug_admin
POSTGRES_DB=sug
# Optional explicit full database URL:
# DATABASE_URL=postgres://sug_admin:sug_dev_password@127.0.0.1:5433/sug

# Cloud Storage emulation and endpoints (S3 / LocalStack)
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:4566
S3_QUARANTINE_BUCKET=sug-quarantine-local
S3_CLEAN_BUCKET=sug-clean-local
AWS_ACCESS_KEY_ID=test

# Cloud Storage emulation and endpoints (GCS / fake-gcs-server)
GCS_ENDPOINT=http://localhost:4443
GCS_REPLICA_BUCKET=sug-replica-local
GCS_PROJECT_ID=sug-local-project

# Secrets directory override (defaults to /run/secrets in container, ./secrets locally)
SECRETS_DIR=./secrets

# ------------------------------------------------------------------------------
# Secrets — supplied through Docker secrets (/run/secrets/*)
# ------------------------------------------------------------------------------
# The variables below are documented for local development reference ONLY.
# In container environments, these are mounted from /run/secrets/<name>.
# Run `bash scripts/gen-secrets.sh` to generate local development secrets.

# Pepper: Used for HMAC generation of API keys and salts
# Generated as 32 cryptographically secure random bytes = 64 hex characters (256-bit entropy).
# Schema enforces a minimum length of 32 characters.
# In Docker: /run/secrets/pepper
SUG_PEPPER=

# KEK: Master Key Encryption Key for AES-256 KeyWrap (RFC 3394) (64 hex characters)
# In Docker: /run/secrets/kek
SUG_KEK=

# JWT Private Key: Ed25519 private key in PKCS#8 PEM format for signing upload session tokens
# In Docker: /run/secrets/jwt_private_key (or jwt_private_key.pem)
SUG_JWT_PRIVATE_KEY=

# Audit Checkpoint Private Key: Ed25519 private key in PKCS#8 PEM format for ledger checkpoints
# In Docker: /run/secrets/checkpoint_private_key (or checkpoint_private_key.pem)
SUG_CHECKPOINT_PRIVATE_KEY=

# PostgreSQL Database password
# In Docker: /run/secrets/db_password
POSTGRES_PASSWORD=

# AWS Secret Access Key (LocalStack test value or AWS IAM secret)
# In Docker: /run/secrets/aws_secret_access_key
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Per-Service Storage Credentials (Optional Overrides)
# ------------------------------------------------------------------------------
# For least-privilege separation across pipeline trust zones (API, Scanner, Promoter, Replicator).
# Each service falls back to global AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY if not specified.
# In Docker: /run/secrets/aws_secret_access_key_<service>
#
# AWS_ACCESS_KEY_ID_API=
# AWS_SECRET_ACCESS_KEY_API=
# AWS_ACCESS_KEY_ID_SCANNER=
# AWS_SECRET_ACCESS_KEY_SCANNER=
# AWS_ACCESS_KEY_ID_PROMOTER=
# AWS_SECRET_ACCESS_KEY_PROMOTER=
# AWS_ACCESS_KEY_ID_REPLICATOR=
# AWS_SECRET_ACCESS_KEY_REPLICATOR=
