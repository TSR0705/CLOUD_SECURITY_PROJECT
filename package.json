{
  "name": "secure-upload-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/validate-yara-rules.mjs packages/scanner/rules && tsc -b",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:create": "node scripts/migrate.mjs create",
    "db:types": "kysely-codegen --out-file packages/shared/src/db.ts --dialect postgres",
    "db:invariants": "node scripts/run-invariants.ts",
    "chaos": "node chaos.ts",
    "rules:validate": "node scripts/validate-yara-rules.mjs packages/scanner/rules"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@google-cloud/storage": "8.2.0",
    "@prometheus-io/client": "^0.16.1",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-boundaries": "7.2.0",
    "jose": "^6.2.12",
    "kysely": "0.29.6",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
